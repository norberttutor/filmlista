# Másold le ezt a fájlt .env.local néven, és töltsd ki.
# A .env.local nem kerül fel GitHubra (benne van a .gitignore-ban).

# Supabase → Project Settings → API (újabb felületen: API Keys)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_KEY=ide-a-publishable-vagy-anon-kulcs

# TMDB – a következő lépésben lesz rá szükség.
# Csak szerveroldalon használjuk, ezért nincs NEXT_PUBLIC előtag.
TMDB_READ_TOKEN=
