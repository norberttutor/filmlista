# Másold le ezt a fájlt .env.local néven, és töltsd ki.
# A .env.local nem kerül fel GitHubra (benne van a .gitignore-ban).

# Supabase → Project Settings → API (újabb felületen: API Keys)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_KEY=ide-a-publishable-vagy-anon-kulcs

# TMDB API Read Access Token.
# Csak szerveroldalon használjuk, ezért nincs NEXT_PUBLIC előtag.
TMDB_READ_TOKEN=

# OMDb API kulcs az IMDb-értékelésekhez (omdbapi.com → API Key → Free, napi 1000 lekérdezés).
# Csak szerveroldalon; Vercelre is fel kell venni. Ha hiányzik, az app értékelés nélkül működik.
OMDB_API_KEY=

# Tesztfelhasználó az automatikus böngészős tesztekhez (csak helyben, Vercelre nem kell).
# Supabase → Authentication → Users → Add user (Auto Confirm User bepipálva).
TEST_USER_EMAIL=
TEST_USER_PASSWORD=

# Adatbázis-kapcsolat a sémamódosítások (supabase/*.sql) futtatásához – csak helyben!
# Supabase → Connect → Connection String → Type: URI, Method: Session pooler.
# Teljes admin jog: soha ne kapjon NEXT_PUBLIC_ előtagot, és ne kerüljön Vercelre.
SUPABASE_DB_URL=
